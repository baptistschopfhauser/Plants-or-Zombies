{
  "name": "bloomguard",
  "version": "3.0.0",
  "private": true,
  "description": "Bloomguard: an original lane-defense garden game for Android and the web.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "test": "node scripts/smoke-test.mjs",
    "assets": "node scripts/make-assets.mjs && npx capacitor-assets generate --android",
    "sync": "npx cap sync android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npx cap sync android && cd android && ./gradlew bundleRelease",
    "desktop": "electron . --windowed",
    "desktop:win": "electron-builder --win --x64",
    "desktop:linux": "electron-builder --linux --x64",
    "desktop:mac": "electron-builder --mac --universal"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs",
  "author": "Bloomguard developers",
  "build": {
    "appId": "io.github.bloomguard.game",
    "productName": "Bloomguard",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**",
      "www/**",
      "package.json",
      "!www/sw.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Game",
      "executableName": "bloomguard"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.strategy-games"
    }
  }
}
